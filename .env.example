# Local development configuration. Copy to .env and fill in.
# On Streamlit Cloud, put the same names in the app's Secrets instead.
MODEL_PROVIDER=bedrock

# -- AWS credentials: pick ONE way ---------------------------------------
# (a) Preferred: no keys in this file. Use an AWS profile locally
#     (run "aws configure"); on AWS the app uses its attached role.
# (b) IAM user access keys. Work for both Bedrock and DynamoDB.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# (c) A Bedrock API key. Works for Bedrock ONLY, not DynamoDB.
# AWS_BEARER_TOKEN_BEDROCK=

# -- Regions ---------------------------------------------------------------
# General AWS region; the DynamoDB table lives here.
AWS_REGION=us-east-1
# Only needed if model calls must go to a different region than AWS_REGION
# (for example, a Bedrock API key created in another region).
# BEDROCK_MODEL_REGION=us-east-1

# -- Models (optional overrides; defaults are in config.py) ----------------
# BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_MODEL_REASONING=us.anthropic.claude-sonnet-4-6

# -- Storage ---------------------------------------------------------------
DYNAMODB_TABLE_NAME=tradedesk-analyses-dev
# false = if DynamoDB is unavailable, keep working with in-memory storage.
# true  = stop with an error instead (the default, meant for production).
FAIL_ON_STORAGE_ERROR=false

# -- Data sources ----------------------------------------------------------
TAVILY_API_KEY=
TWELVE_DATA_API_KEY=

# Only required when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
