# Local development configuration. Authenticate to AWS with an SSO/profile;
# ECS uses its task role, so never put long-lived AWS keys in this file.
MODEL_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_REASONING=us.anthropic.claude-sonnet-4-6

DYNAMODB_TABLE_NAME=tradedesk-analyses-dev
FAIL_ON_STORAGE_ERROR=false

TAVILY_API_KEY=
TWELVE_DATA_API_KEY=

# Only required when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
